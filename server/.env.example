# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nutrition_planner"
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-long"
JWT_REFRESH_SECRET="your-refresh-secret-key-min-32-characters-long"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# AI Services (Free tiers available)
# Get your free API key at: https://console.groq.com (1M tokens/day free)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Optional: OpenAI fallback (Get $5 credit for 3 months)
OPENAI_API_KEY="sk-your_openai_key"

# Google Cloud Vision (1K requests/month free)
# Download service account JSON and set path
GOOGLE_APPLICATION_CREDENTIALS="./google-credentials.json"

# USDA FoodData Central API (Free unlimited)
# Get key at: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY="your_usda_api_key"

# Hugging Face (Optional - 30K requests/month free)
HF_API_KEY="hf_your_huggingface_key"

# File Storage - Cloudinary (25 credits/month free)
# Sign up at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Application
NODE_ENV="development"
PORT=3000
CLIENT_URL="http://localhost:5173"
LOG_LEVEL="debug"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
